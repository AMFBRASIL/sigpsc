NODE_ENV=development
PORT=3340
DATABASE_URL="mysql://USUARIO:SENHA@127.0.0.1:3306/sigpsc"
ADMIN_INITIAL_PASSWORD="troque-esta-senha-inicial"
SEED_DEMO=false
STORAGE_DIR=storage
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://127.0.0.1:3340
SESSION_HOURS=12
# Chave usada só para cifrar senha SMTP e chave de API no banco. Não é a senha de e-mail.
MAIL_ENCRYPTION_KEY=troque-esta-chave
# Opcional, quando houver Redis:
# REDIS_URL=redis://127.0.0.1:6379
# Opcional, armazenamento S3 compatível:
# S3_ENDPOINT=
# S3_BUCKET=sigpsc-privado
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
