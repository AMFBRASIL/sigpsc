generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model api_chaves {
  id          Int                 @id @default(autoincrement()) @db.UnsignedInt
  nome        String              @db.VarChar(80)
  ambiente    api_chaves_ambiente @default(Produ__o)
  prefixo     String              @db.VarChar(12)
  ultimos4    String              @db.Char(4)
  chave_hash  String              @unique(map: "chave_hash") @db.Char(64)
  escopos     String?             @db.LongText
  ultimo_uso  DateTime?           @db.DateTime(0)
  revogada_em DateTime?           @db.DateTime(0)
  criado_por  Int?                @db.UnsignedInt
  criado_em   DateTime            @default(now()) @db.DateTime(0)
  usuarios    usuarios?           @relation(fields: [criado_por], references: [id], onUpdate: Restrict, map: "api_chaves_ibfk_1")

  @@index([criado_por], map: "criado_por")
}

model atividades {
  id              Int               @id @default(autoincrement()) @db.UnsignedInt
  local_id        Int?              @db.UnsignedInt
  nome            String            @db.VarChar(120)
  descricao       String?           @db.VarChar(255)
  ativo           Boolean           @default(true)
  locais          locais?           @relation(fields: [local_id], references: [id], onUpdate: Restrict, map: "atividades_ibfk_1")
  escalas         escalas[]
  registros_horas registros_horas[]

  @@index([local_id], map: "local_id")
}

model auditoria {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  usuario_id   Int?         @db.UnsignedInt
  prestador_id Int?         @db.UnsignedInt
  acao         String       @db.VarChar(60)
  entidade     String       @db.VarChar(60)
  entidade_id  String?      @db.VarChar(40)
  descricao    String?      @db.VarChar(500)
  dados_antes  String?      @db.LongText
  dados_depois String?      @db.LongText
  ip           String?      @db.VarChar(45)
  criado_em    DateTime     @default(now()) @db.DateTime(0)
  usuarios     usuarios?    @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "auditoria_ibfk_1")
  prestadores  prestadores? @relation(fields: [prestador_id], references: [id], onUpdate: Restrict, map: "auditoria_ibfk_2")

  @@index([criado_em], map: "criado_em")
  @@index([entidade, entidade_id], map: "entidade")
  @@index([prestador_id], map: "prestador_id")
  @@index([usuario_id], map: "usuario_id")
}

model automacao_execucoes {
  id           BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  automacao_id Int                        @db.UnsignedInt
  referencia   String?                    @db.VarChar(80)
  status       automacao_execucoes_status
  detalhe      String?                    @db.VarChar(500)
  criado_em    DateTime                   @default(now()) @db.DateTime(0)
  automacoes   automacoes                 @relation(fields: [automacao_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "automacao_execucoes_ibfk_1")

  @@index([automacao_id], map: "automacao_id")
}

model automacoes {
  id                  Int                   @id @default(autoincrement()) @db.UnsignedInt
  nome                String                @db.VarChar(120)
  gatilho             automacoes_gatilho
  parametros_json     String?               @db.LongText
  acao                automacoes_acao
  destino             automacoes_destino    @default(Prestador)
  mensagem            String?               @db.Text
  ativo               Boolean               @default(true)
  ultima_execucao     DateTime?             @db.DateTime(0)
  criado_por          Int?                  @db.UnsignedInt
  criado_em           DateTime              @default(now()) @db.DateTime(0)
  automacao_execucoes automacao_execucoes[]
  usuarios            usuarios?             @relation(fields: [criado_por], references: [id], onUpdate: Restrict, map: "automacoes_ibfk_1")

  @@index([criado_por], map: "criado_por")
}

model backups {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  tipo          backups_tipo
  arquivo_url   String?        @db.VarChar(255)
  tamanho_bytes BigInt?        @db.UnsignedBigInt
  status        backups_status
  criado_em     DateTime       @default(now()) @db.DateTime(0)
}

model comarcas {
  id    Int     @id @default(autoincrement()) @db.UnsignedInt
  nome  String  @db.VarChar(120)
  uf    String  @db.Char(2)
  varas varas[]

  @@unique([nome, uf], map: "uk_comarca")
}

model config_email {
  id                 Int                          @id @default(1) @db.UnsignedTinyInt
  metodo             config_email_metodo          @default(API)
  provedor           config_email_provedor?
  api_key_cifrada    Bytes?                       @db.VarBinary(512)
  smtp_host          String?                      @db.VarChar(150)
  smtp_porta         Int?                         @db.UnsignedSmallInt
  smtp_usuario       String?                      @db.VarChar(150)
  smtp_senha_cifrada Bytes?                       @db.VarBinary(512)
  smtp_seguranca     config_email_smtp_seguranca? @default(TLS)
  remetente_email    String                       @db.VarChar(150)
  remetente_nome     String                       @db.VarChar(150)
  dominio_envio      String?                      @db.VarChar(150)
  dominio_verificado Boolean                      @default(false)
  assinatura         String?                      @db.Text
  resumo_diario      Boolean                      @default(true)
  lembrete_escala    Boolean                      @default(true)
  relatorio_mensal   Boolean                      @default(false)
  atualizado_em      DateTime                     @default(now()) @db.DateTime(0)
}

model config_geral {
  chave          String    @id @db.VarChar(80)
  valor          String?   @db.Text
  descricao      String?   @db.VarChar(255)
  atualizado_por Int?      @db.UnsignedInt
  atualizado_em  DateTime  @default(now()) @db.DateTime(0)
  usuarios       usuarios? @relation(fields: [atualizado_por], references: [id], onUpdate: Restrict, map: "config_geral_ibfk_1")

  @@index([atualizado_por], map: "atualizado_por")
}

model documento_assinaturas {
  id           Int          @id @default(autoincrement()) @db.UnsignedInt
  documento_id Int          @db.UnsignedInt
  usuario_id   Int?         @db.UnsignedInt
  prestador_id Int?         @db.UnsignedInt
  assinado_em  DateTime?    @db.DateTime(0)
  ip           String?      @db.VarChar(45)
  certificado  String?      @db.VarChar(255)
  documentos   documentos   @relation(fields: [documento_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "documento_assinaturas_ibfk_1")
  usuarios     usuarios?    @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "documento_assinaturas_ibfk_2")
  prestadores  prestadores? @relation(fields: [prestador_id], references: [id], onUpdate: Restrict, map: "documento_assinaturas_ibfk_3")

  @@index([documento_id], map: "documento_id")
  @@index([prestador_id], map: "prestador_id")
  @@index([usuario_id], map: "usuario_id")
}

model documentos {
  id                    Int                     @id @default(autoincrement()) @db.UnsignedInt
  processo_id           Int?                    @db.UnsignedInt
  prestador_id          Int?                    @db.UnsignedInt
  nome                  String                  @db.VarChar(200)
  tipo                  documentos_tipo
  status                documentos_status       @default(Rascunho)
  arquivo_url           String?                 @db.VarChar(255)
  mime                  String?                 @db.VarChar(80)
  tamanho_bytes         Int?                    @db.UnsignedInt
  hash_sha256           String?                 @db.Char(64)
  visivel_prestador     Boolean                 @default(false)
  prazo_envio           DateTime?               @db.Date
  enviado_em            DateTime?               @db.DateTime(0)
  protocolo_forum       String?                 @db.VarChar(60)
  criado_por            Int?                    @db.UnsignedInt
  criado_em             DateTime                @default(now()) @db.DateTime(0)
  atualizado_em         DateTime                @default(now()) @db.DateTime(0)
  codigo_verificacao    String?                 @unique(map: "documentos_codigo_verificacao") @db.Char(16)
  em_quarentena         Boolean                 @default(false)
  documento_assinaturas documento_assinaturas[]
  processos             processos?              @relation(fields: [processo_id], references: [id], onUpdate: Restrict, map: "documentos_ibfk_1")
  prestadores           prestadores?            @relation(fields: [prestador_id], references: [id], onUpdate: Restrict, map: "documentos_ibfk_2")
  usuarios              usuarios?               @relation(fields: [criado_por], references: [id], onUpdate: Restrict, map: "documentos_ibfk_3")
  relatorios_emitidos   relatorios_emitidos[]

  @@index([criado_por], map: "criado_por")
  @@index([prestador_id], map: "prestador_id")
  @@index([processo_id], map: "processo_id")
  @@index([status], map: "status")
  @@index([tipo], map: "tipo")
}

model email_envios {
  id           BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  destinatario String              @db.VarChar(150)
  assunto      String              @db.VarChar(200)
  modelo       String?             @db.VarChar(60)
  status       email_envios_status @default(Na_fila)
  corpo        String?             @db.MediumText
  erro         String?             @db.VarChar(500)
  enviado_em   DateTime?           @db.DateTime(0)
  criado_em    DateTime            @default(now()) @db.DateTime(0)

  @@index([status], map: "status")
}

model escalas {
  id               Int                 @id @default(autoincrement()) @db.UnsignedInt
  processo_id      Int                 @db.UnsignedInt
  local_id         Int                 @db.UnsignedInt
  atividade_id     Int?                @db.UnsignedInt
  data             DateTime            @db.Date
  hora_inicio      DateTime            @db.Time(0)
  hora_fim         DateTime            @db.Time(0)
  recorrencia      escalas_recorrencia @default(Nenhuma)
  status           escalas_status      @default(Agendada)
  justificativa    String?             @db.VarChar(255)
  lembrete_enviado Boolean             @default(false)
  criado_por       Int?                @db.UnsignedInt
  criado_em        DateTime            @default(now()) @db.DateTime(0)
  processos        processos           @relation(fields: [processo_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "escalas_ibfk_1")
  locais           locais              @relation(fields: [local_id], references: [id], onUpdate: Restrict, map: "escalas_ibfk_2")
  atividades       atividades?         @relation(fields: [atividade_id], references: [id], onUpdate: Restrict, map: "escalas_ibfk_3")
  usuarios         usuarios?           @relation(fields: [criado_por], references: [id], onUpdate: Restrict, map: "escalas_ibfk_4")
  registros_horas  registros_horas[]

  @@index([atividade_id], map: "atividade_id")
  @@index([criado_por], map: "criado_por")
  @@index([data], map: "data")
  @@index([local_id, data], map: "local_id")
  @@index([processo_id], map: "processo_id")
}

model exportacoes {
  id          Int                  @id @default(autoincrement()) @db.UnsignedInt
  conteudo    exportacoes_conteudo
  formato     exportacoes_formato
  arquivo_url String?              @db.VarChar(255)
  usuario_id  Int?                 @db.UnsignedInt
  criado_em   DateTime             @default(now()) @db.DateTime(0)
  usuarios    usuarios?            @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "exportacoes_ibfk_1")

  @@index([usuario_id], map: "usuario_id")
}

model integracoes {
  id                   Int                 @id @default(autoincrement()) @db.UnsignedInt
  servico              integracoes_servico @unique(map: "servico")
  conta                String?             @db.VarChar(150)
  token_cifrado        Bytes?              @db.VarBinary(1024)
  enviar_horas         Boolean             @default(false)
  receber_processos    Boolean             @default(false)
  sincronizar_escalas  Boolean             @default(false)
  conectado            Boolean             @default(false)
  ultima_sincronizacao DateTime?           @db.DateTime(0)
  atualizado_em        DateTime            @default(now()) @db.DateTime(0)
}

model lgpd_solicitacoes {
  id            Int                      @id @default(autoincrement()) @db.UnsignedInt
  prestador_id  Int?                     @db.UnsignedInt
  tipo          lgpd_solicitacoes_tipo
  status        lgpd_solicitacoes_status @default(Aberta)
  resposta      String?                  @db.Text
  criado_em     DateTime                 @default(now()) @db.DateTime(0)
  respondido_em DateTime?                @db.DateTime(0)
  prestadores   prestadores?             @relation(fields: [prestador_id], references: [id], onUpdate: Restrict, map: "lgpd_solicitacoes_ibfk_1")

  @@index([prestador_id], map: "prestador_id")
}

model locais {
  id                                                                                Int                             @id @default(autoincrement()) @db.UnsignedInt
  nome                                                                              String                          @db.VarChar(150)
  tipo                                                                              locais_tipo                     @default(Outro)
  cnpj                                                                              String?                         @db.VarChar(18)
  endereco                                                                          String?                         @db.VarChar(200)
  bairro                                                                            String?                         @db.VarChar(100)
  cidade                                                                            String?                         @db.VarChar(100)
  uf                                                                                String?                         @db.Char(2)
  cep                                                                               String?                         @db.VarChar(9)
  latitude                                                                          Decimal?                        @db.Decimal(10, 7)
  longitude                                                                         Decimal?                        @db.Decimal(10, 7)
  raio_metros                                                                       Int?                            @default(200) @db.UnsignedSmallInt
  vagas                                                                             Int                             @default(0) @db.UnsignedSmallInt
  abre_as                                                                           DateTime?                       @db.Time(0)
  fecha_as                                                                          DateTime?                       @db.Time(0)
  responsavel                                                                       String?                         @db.VarChar(120)
  telefone                                                                          String?                         @db.VarChar(20)
  email                                                                             String?                         @db.VarChar(150)
  ativo                                                                             Boolean                         @default(true)
  criado_em                                                                         DateTime                        @default(now()) @db.DateTime(0)
  atualizado_em                                                                     DateTime                        @default(now()) @db.DateTime(0)
  atividades                                                                        atividades[]
  escalas                                                                           escalas[]
  processo_transferencias_local_processo_transferencias_local_local_origemTolocais  processo_transferencias_local[] @relation("processo_transferencias_local_local_origemTolocais")
  processo_transferencias_local_processo_transferencias_local_local_destinoTolocais processo_transferencias_local[] @relation("processo_transferencias_local_local_destinoTolocais")
  processos                                                                         processos[]
  registros_horas                                                                   registros_horas[]
  usuarios                                                                          usuarios[]
}

model modelos_documento {
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  nome     String  @db.VarChar(120)
  tipo     String  @db.VarChar(40)
  conteudo String  @db.MediumText
  ativo    Boolean @default(true)
}

model notificacoes {
  id           BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  usuario_id   Int?               @db.UnsignedInt
  prestador_id Int?               @db.UnsignedInt
  tipo         notificacoes_tipo  @default(info)
  titulo       String             @db.VarChar(150)
  texto        String             @db.VarChar(500)
  link         String?            @db.VarChar(200)
  canal        notificacoes_canal @default(Sistema)
  lida_em      DateTime?          @db.DateTime(0)
  enviada_em   DateTime?          @db.DateTime(0)
  criado_em    DateTime           @default(now()) @db.DateTime(0)
  usuarios     usuarios?          @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notificacoes_ibfk_1")
  prestadores  prestadores?       @relation(fields: [prestador_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notificacoes_ibfk_2")

  @@index([prestador_id], map: "prestador_id")
  @@index([usuario_id, lida_em], map: "usuario_id")
}

model perfil_telas {
  perfil_id   Int     @db.UnsignedInt
  tela_id     String  @db.VarChar(40)
  pode_ver    Boolean @default(true)
  pode_editar Boolean @default(false)
  perfis      perfis  @relation(fields: [perfil_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "perfil_telas_ibfk_1")
  telas       telas   @relation(fields: [tela_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "perfil_telas_ibfk_2")

  @@id([perfil_id, tela_id])
  @@index([tela_id], map: "tela_id")
}

model perfis {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  nome          String         @unique(map: "nome") @db.VarChar(80)
  descricao     String?        @db.VarChar(255)
  cor           Int            @default(0) @db.UnsignedTinyInt
  sistema       Boolean        @default(false)
  criado_em     DateTime       @default(now()) @db.DateTime(0)
  atualizado_em DateTime       @default(now()) @db.DateTime(0)
  perfil_telas  perfil_telas[]
  usuarios      usuarios[]
}

model prestador_contatos_emergencia {
  id           Int         @id @default(autoincrement()) @db.UnsignedInt
  prestador_id Int         @db.UnsignedInt
  nome         String      @db.VarChar(150)
  parentesco   String?     @db.VarChar(50)
  telefone     String      @db.VarChar(20)
  prestadores  prestadores @relation(fields: [prestador_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "prestador_contatos_emergencia_ibfk_1")

  @@index([prestador_id], map: "prestador_id")
}

model prestadores {
  id                            Int                             @id @default(autoincrement()) @db.UnsignedInt
  nome                          String                          @db.VarChar(150)
  nome_social                   String?                         @db.VarChar(150)
  cpf                           String                          @unique(map: "cpf") @db.VarChar(14)
  rg                            String?                         @db.VarChar(20)
  data_nascimento               DateTime?                       @db.Date
  sexo                          prestadores_sexo?
  estado_civil                  String?                         @db.VarChar(30)
  escolaridade                  String?                         @db.VarChar(60)
  profissao                     String?                         @db.VarChar(80)
  telefone                      String?                         @db.VarChar(20)
  whatsapp                      String?                         @db.VarChar(20)
  email                         String?                         @db.VarChar(150)
  cep                           String?                         @db.VarChar(9)
  endereco                      String?                         @db.VarChar(200)
  bairro                        String?                         @db.VarChar(100)
  cidade                        String?                         @db.VarChar(100)
  uf                            String?                         @db.Char(2)
  restricoes_saude              String?                         @db.Text
  disponibilidade               String?                         @db.VarChar(255)
  foto_url                      String?                         @db.VarChar(255)
  senha_hash                    String?                         @db.VarChar(255)
  ultimo_acesso                 DateTime?                       @db.DateTime(0)
  criado_por                    Int?                            @db.UnsignedInt
  criado_em                     DateTime                        @default(now()) @db.DateTime(0)
  atualizado_em                 DateTime                        @default(now()) @db.DateTime(0)
  auditoria                     auditoria[]
  documento_assinaturas         documento_assinaturas[]
  documentos                    documentos[]
  lgpd_solicitacoes             lgpd_solicitacoes[]
  notificacoes                  notificacoes[]
  prestador_contatos_emergencia prestador_contatos_emergencia[]
  usuarios                      usuarios?                       @relation(fields: [criado_por], references: [id], onUpdate: Restrict, map: "prestadores_ibfk_1")
  processos                     processos[]
  registros_horas               registros_horas[]
  sessoes                       sessoes[]

  @@index([criado_por], map: "criado_por")
  @@index([nome], map: "nome")
}

model processo_historico_situacao {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  processo_id   Int       @db.UnsignedInt
  de_situacao   String?   @db.VarChar(20)
  para_situacao String    @db.VarChar(20)
  motivo        String?   @db.VarChar(255)
  usuario_id    Int?      @db.UnsignedInt
  criado_em     DateTime  @default(now()) @db.DateTime(0)
  processos     processos @relation(fields: [processo_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "processo_historico_situacao_ibfk_1")
  usuarios      usuarios? @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "processo_historico_situacao_ibfk_2")

  @@index([processo_id], map: "processo_id")
  @@index([usuario_id], map: "usuario_id")
}

model processo_transferencias_local {
  id                                                         Int       @id @default(autoincrement()) @db.UnsignedInt
  processo_id                                                Int       @db.UnsignedInt
  local_origem                                               Int?      @db.UnsignedInt
  local_destino                                              Int       @db.UnsignedInt
  motivo                                                     String?   @db.VarChar(255)
  usuario_id                                                 Int?      @db.UnsignedInt
  criado_em                                                  DateTime  @default(now()) @db.DateTime(0)
  processos                                                  processos @relation(fields: [processo_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "processo_transferencias_local_ibfk_1")
  locais_processo_transferencias_local_local_origemTolocais  locais?   @relation("processo_transferencias_local_local_origemTolocais", fields: [local_origem], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "processo_transferencias_local_ibfk_2")
  locais_processo_transferencias_local_local_destinoTolocais locais    @relation("processo_transferencias_local_local_destinoTolocais", fields: [local_destino], references: [id], onUpdate: Restrict, map: "processo_transferencias_local_ibfk_3")
  usuarios                                                   usuarios? @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "processo_transferencias_local_ibfk_4")

  @@index([local_destino], map: "local_destino")
  @@index([local_origem], map: "local_origem")
  @@index([processo_id], map: "processo_id")
  @@index([usuario_id], map: "usuario_id")
}

model processos {
  id                                         Int                             @id @default(autoincrement()) @db.UnsignedInt
  prestador_id                               Int                             @db.UnsignedInt
  numero                                     String                          @unique(map: "numero") @db.VarChar(30)
  vara_id                                    Int?                            @db.UnsignedInt
  juiz                                       String?                         @db.VarChar(150)
  tipo_pena                                  processos_tipo_pena             @default(PSC)
  horas_totais                               Decimal                         @db.Decimal(7, 2)
  horas_semanais_min                         Decimal?                        @db.Decimal(5, 2)
  data_decisao                               DateTime?                       @db.Date
  data_inicio                                DateTime?                       @db.Date
  prazo_final                                DateTime?                       @db.Date
  local_id                                   Int?                            @db.UnsignedInt
  supervisor_id                              Int?                            @db.UnsignedInt
  tecnico_id                                 Int?                            @db.UnsignedInt
  situacao                                   processos_situacao              @default(Pendente)
  motivo_situacao                            String?                         @db.VarChar(255)
  concluido_em                               DateTime?                       @db.Date
  observacoes                                String?                         @db.Text
  criado_em                                  DateTime                        @default(now()) @db.DateTime(0)
  atualizado_em                              DateTime                        @default(now()) @db.DateTime(0)
  horas_semanais_max                         Decimal?                        @db.Decimal(5, 2)
  restricoes                                 String?                         @db.Text
  tribunal                                   String?                         @db.VarChar(120)
