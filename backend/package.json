    "@prisma/client": "^6.16.2",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.17.2",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.2",
    "@types/qrcode": "^1.5.5",
    "mysql2": "^3.15.1",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
